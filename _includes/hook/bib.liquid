{% comment %}
  Site-local hook for al_folio_core's bib layout (included right before the
  periodical line is assembled). Appends the event from _data/pub_events.yml
  after the year, e.g. "ISPRS Annals ..., 2026 (ISPRS Congress 2026)".
{% endcomment %}
{%- assign pub_event = site.data.pub_events[entry.key] -%}
{%- if pub_event -%}
  {%- capture entryyear -%}{{ entryyear }} ({{ pub_event }}){%- endcapture -%}
{%- endif -%}
